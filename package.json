{
  "name": "umalator",
  "description": "Web interface for Uma Musume skill efficiency calculations",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsx build.ts",
    "build:frontend": "vite build",
    "dev": "npm run build && vite",
    "markdownlint": "markdownlint-cli2 \"**/*.md\"",
    "postinstall": "node scripts/pin-submodule.mjs",
    "setup": "git submodule update --init --recursive && node scripts/pin-submodule.mjs --strict && npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "node scripts/typecheck.mjs",
    "preview": "npm run build && npm run build:frontend && vite preview",
    "race-check": "tsx race-check.ts"
  },
  "dependencies": {
    "driver.js": "^1.4.0",
    "esbuild": "^0.27.2",
    "immutable": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^4.0.17",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.17"
  }
}
